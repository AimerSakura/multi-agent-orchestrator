{
  "mcpServers": {
    "codex-worker": {
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--directory",
        "<PATH_TO_REPO>/packages/dsh-mcp-bridge",
        "python",
        "-m",
        "dsh_mcp_bridge.codex_server"
      ],
      "env": {
        "CODEX_BIN": "codex",
        "CODEX_DEFAULT_MODEL": "gpt-6-luna",
        "CODEX_ALLOWED_MODELS": "gpt-6-luna,gpt-5.6-luna",
        "CODEX_ALLOW_ESCALATION": "false",
        "CODEX_ALLOWED_ROOT": "<YOUR_WORKSPACE_ROOT>",
        "CODEX_DEFAULT_TIMEOUT": "300"
      }
    },
    "deepseek-harness": {
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--directory",
        "<PATH_TO_REPO>/packages/dsh-mcp-bridge",
        "python",
        "-m",
        "dsh_mcp_bridge.server"
      ],
      "env": {
        "DSH_BASE_URL": "http://127.0.0.1:3080",
        "DSH_ALLOWED_ROOT": "<YOUR_WORKSPACE_ROOT>",
        "DSH_DEFAULT_TIMEOUT": "300",
        "DSH_APPROVAL_POLICY": "never"
      }
    }
  }
}
